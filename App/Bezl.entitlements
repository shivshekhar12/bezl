<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: Core Audio process taps and Apple Events to Music/Spotify work
	     without temporary exceptions. Hardened runtime still applies. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
